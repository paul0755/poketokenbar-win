{
  "name": "poketokenbar-win",
  "productName": "PokeTokenBar",
  "version": "0.3.0",
  "description": "토큰을 써서 포켓몬을 키우는 Windows 트레이 앱 + 데스크톱 펫",
  "keywords": [
    "electron",
    "windows",
    "tray",
    "pokemon",
    "claude-code",
    "codex",
    "token-usage",
    "desktop-pet"
  ],
  "license": "MIT",
  "author": {
    "name": "yezandi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul0755/poketokenbar-win.git"
  },
  "homepage": "https://github.com/paul0755/poketokenbar-win#readme",
  "bugs": {
    "url": "https://github.com/paul0755/poketokenbar-win/issues"
  },
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "probe": "node src/main/usage.js",
    "lines": "node scripts/build-lines.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-builder --win",
    "profiles": "node scripts/build-profiles.mjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.yezandi.poketokenbar",
    "productName": "PokeTokenBar",
    "copyright": "MIT · idea from chattymin/PokeTokenBar",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/.cache-pokeapi"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PokeTokenBar",
      "artifactName": "PokeTokenBar-Setup-${version}.${ext}",
      "runAfterFinish": false
    }
  }
}
