# 의존성 · 빌드 산출물
node_modules/
dist/

# PokéAPI 응답 캐시. 생성 스크립트가 다시 만든다 (npm run lines / profiles)
.cache-pokeapi/

# 설치 파일은 저장소가 아니라 Releases 에 올린다
*.exe
*.nsis.7z
*.blockmap

# 진행 상황 파일. 개인 기록이라 절대 들어오면 안 된다 —
# 디버깅하려고 %APPDATA% 에서 복사해 두는 일이 실제로 생긴다
save.json
save.json.*

# 로그
*.log
npm-debug.log*

# 환경 변수 (쓰는 곳은 없지만 실수로 들어오는 걸 막는다)
.env
.env.*

# 편집기
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# 중계 서버 로컬 실행 흔적 (wrangler dev)
